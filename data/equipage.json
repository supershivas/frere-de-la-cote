    "canonnier": {
      "nom": "canonnier",
      "court": "canon",
      "verbe": "sa valeur part dans la volée",
      "aide": "Deux canonniers ensemble forment une bordée, trois une bordée pleine."
    },
    "gabier": {
      "nom": "gabier",
      "court": "gabier",
      "verbe": "règle le tir sur le meilleur canonnier",
      "aide": "Seul il ne vaut rien. Avec un canonnier, il tire à la même valeur que lui."
    },
    "abordeur": {
      "nom": "abordeur",
      "court": "abord.",
      "verbe": "compte double sous la moitié",
      "aide": "Inutile tant que la coque tient. Sous la moitié, sa valeur compte double — et deux abordeurs ensemble sautent à bord : les dégâts portent sans gâter la cargaison."
    },
    "charpentier": {
      "nom": "charpentier",
      "court": "charp.",
      "verbe": "ne tire pas ; répare s'il est seul",
      "aide": "Une volée d'un seul charpentier rend 12 à La Tortue et jette une carte Feu. Accompagné, il ne fait rien."
    }
  },
